{
    "tools": [
          {
                  "name": "departi_check_visa",
                  "annotations": {
                            "title": "Check Visa Requirements",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": false
                  },
                  "description": "Visa requirements for 43 European countries. Covers tourist, nomad, work, study, retirement. Includes destination context. Personalizes when registered.",
                  "inputSchema": {
                            "type": "object",
                            "properties": {
                                        "nationality": { "type": "string", "description": "ISO alpha-2, e.g. 'BE'" },
                                        "destination": { "type": "string", "description": "ISO alpha-2, e.g. 'PT'" },
                                        "purpose": {
                                                      "type": "string",
                                                      "description": "e.g. 'tourism', 'remote_work', 'business', 'study', 'retirement'",
                                                      "default": "tourism"
                                        },
                                        "duration": { "type": "integer", "description": "Stay in days" },
                                        "locale": { "type": "string", "default": "en" },
                                        "currency": { "type": "string", "default": "EUR" }
                            },
                            "required": ["nationality", "destination", "duration"]
                  }
          },
          {
                  "name": "departi_track_schengen",
                  "annotations": {
                            "title": "Track Schengen Days",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": false
                  },
                  "description": "Schengen 90/180 calculator with tax residency warnings. Persistent tracking when registered.",
                  "inputSchema": {
                            "type": "object",
                            "properties": {
                                        "entries": {
                                                      "type": "array",
                                                      "items": {
                                                                      "type": "object",
                                                                      "properties": {
                                                                                        "country": { "type": "string" },
                                                                                        "entryDate": { "type": "string", "format": "date" },
                                                                                        "exitDate": { "type": "string", "format": "date" }
                                                                      },
                                                                      "required": ["country", "entryDate", "exitDate"]
                                                      }
                                        },
                                        "referenceDate": { "type": "string", "format": "date" },
                                        "nationality": { "type": "string" },
                                        "locale": { "type": "string", "default": "en" },
                                        "currency": { "type": "string", "default": "EUR" }
                            },
                            "required": ["entries"]
                  }
          },
          {
                  "name": "departi_check_tax",
                  "annotations": {
                            "title": "Check Tax Residency",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": false
                  },
                  "description": "Tax residency analysis for 43 countries. Treaties, DN regimes, social security. Advisory only.",
                  "inputSchema": {
                            "type": "object",
                            "properties": {
                                        "nationality": { "type": "string" },
                                        "taxResidence": { "type": "string", "description": "Current tax home country" },
                                        "destination": { "type": "string" },
                                        "duration": { "type": "integer" },
                                        "purpose": {
                                                      "type": "string",
                                                      "description": "e.g. 'tourism', 'remote_work', 'business'",
                                                      "default": "tourism"
                                        },
                                        "employmentType": {
                                                      "type": "string",
                                                      "description": "e.g. 'employed', 'self_employed', 'company_director', 'retired'"
                                        },
                                        "yearToDateDays": { "type": "integer", "default": 0 },
                                        "locale": { "type": "string", "default": "en" },
                                        "currency": { "type": "string", "default": "EUR" }
                            },
                            "required": ["nationality", "taxResidence", "destination", "duration"]
                  }
          },
          {
                  "name": "departi_search_accommodation",
                  "annotations": {
                            "title": "Search Accommodation",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": true
                  },
                  "description": "Accommodation search across European destinations. Scored by traveler type. Returns booking links.",
                  "inputSchema": {
                            "type": "object",
                            "properties": {
                                        "destination": { "type": "string" },
                                        "checkin": { "type": "string", "format": "date" },
                                        "checkout": { "type": "string", "format": "date" },
                                        "guests": { "type": "integer", "default": 1 },
                                        "rooms": { "type": "integer", "default": 1 },
                                        "maxPrice": { "type": "number", "description": "Per night in EUR" },
                                        "currency": { "type": "string", "default": "EUR" },
                                        "locale": { "type": "string", "default": "en" },
                                        "persona": {
                                                      "type": "string",
                                                      "description": "e.g. 'culture_explorer', 'foodie', 'adventure'"
                                        },
                                        "traveler_type": {
                                                      "type": "string",
                                                      "description": "e.g. 'digital_nomad', 'slow_traveler', 'weekend_breaker'"
                                        }
                            },
                            "required": ["destination", "checkin", "checkout"]
                  }
          },
          {
                  "name": "departi_search_transport",
                  "annotations": {
                            "title": "Search Flights",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": true
                  },
                  "description": "Flight search: budget and full-service carriers. Returns pricing, stops, booking links.",
                  "inputSchema": {
                            "type": "object",
                            "properties": {
                                        "origin": { "type": "string", "description": "IATA or city, e.g. 'BRU'" },
                                        "destination": { "type": "string", "description": "IATA or city, e.g. 'LIS'" },
                                        "departure_date": { "type": "string", "format": "date" },
                                        "return_date": { "type": "string", "format": "date" },
                                        "passengers": { "type": "integer", "default": 1 },
                                        "mode": {
                                                      "type": "string",
                                                      "default": "all",
                                                      "description": "'all', 'flights', or 'ground'"
                                        },
                                        "traveler_type": {
                                                      "type": "string",
                                                      "description": "e.g. 'digital_nomad', 'weekend_breaker'"
                                        }
                            },
                            "required": ["origin", "destination", "departure_date"]
                  }
          },
          {
                  "name": "departi_search_experiences",
                  "annotations": {
                            "title": "Search Experiences",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": true
                  },
                  "description": "Tours, activities, local experiences. Matched to traveler personality. Returns booking links.",
                  "inputSchema": {
                            "type": "object",
                            "properties": {
                                        "destination": { "type": "string" },
                                        "categories": {
                                                      "type": "array",
                                                      "items": { "type": "string" },
                                                      "description": "e.g. 'cultural', 'culinary', 'adventure', 'wellness', 'nature'"
                                        },
                                        "persona": {
                                                      "type": "string",
                                                      "description": "e.g. 'culture_explorer', 'foodie', 'adventure'"
                                        },
                                        "traveler_type": {
                                                      "type": "string",
                                                      "description": "e.g. 'digital_nomad', 'slow_traveler'"
                                        },
                                        "limit": { "type": "integer", "default": 10 }
                            },
                            "required": ["destination"]
                  }
          },
          {
                  "name": "departi_get_profile",
                  "annotations": {
                            "title": "Get User Profile",
                            "readOnlyHint": true,
                            "destructiveHint": false,
                            "idempotentHint": true,
                            "openWorldHint": false
                  },
                  "description": "User profile: preferences, travel history, subscription tier, compliance summary. Requires auth.",
                  "inputSchema": { "type": "object", "properties": {}, "required": [] }
          }
    ]
}
